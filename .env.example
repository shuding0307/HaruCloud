# ─────────────────────────────────────────────────────────────
# HaruCloud 환경변수 예시 — 이 파일을 .env.local 로 복사해 값을 채우세요.
# 실제 비밀값은 절대 저장소에 커밋하지 마세요. (.env* 는 .gitignore 처리됨)
# ─────────────────────────────────────────────────────────────

# 데이터 모드: "supabase" | "mock"
#  - 비워두면: 개발 환경(next dev)에서는 mock, 프로덕션에서는 supabase 로 동작합니다.
#  - mock 은 서버 메모리에만 저장되며 사용자 간 공유·영구 저장되지 않습니다.
DATA_MODE=mock

# 프로덕션 빌드에서 mock 모드를 의도적으로 켤 때만 true (데모용). 기본값 false.
ALLOW_MOCK_IN_PRODUCTION=false

# Supabase (서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 마세요)
SUPABASE_URL=https://your-project-ref.supabase.co
# service role key 는 서버에서만 사용되며 브라우저로 전달되지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# 익명 식별 토큰 서명 및 IP 해시용 비밀값 (32자 이상 무작위 문자열)
# 생성 예: openssl rand -base64 48
ANON_TOKEN_SECRET=
